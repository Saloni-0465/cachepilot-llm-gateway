# Copy this file to .env and replace this value with a random local gateway key.
CACHEPILOT_API_KEY=replace-with-a-long-random-value

# Keep the mock provider for a free local demo. Set openai to call OpenAI.
LLM_PROVIDER=mock
OPENAI_API_KEY=

CACHE_TTL_SECONDS=300
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Optional model-specific rates, expressed as USD per 1M tokens.
OPENAI_INPUT_PRICE_USD_PER_1M_TOKENS=
OPENAI_OUTPUT_PRICE_USD_PER_1M_TOKENS=
